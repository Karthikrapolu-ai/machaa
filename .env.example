# Machaa Day 1 does not call a paid AI API. Do not put keys in this file.
# Docker Compose already has safe defaults. Copy this to .env only to
# change a setting when you run Python yourself.

MACHAA_HOST=127.0.0.1
MACHAA_PORT=8787
MACHAA_DATA_DIR=data
MACHAA_BROWSER_PROFILE=data/browser-profile
MACHAA_MAX_STEPS=8
MACHAA_TASK_TIMEOUT_SECONDS=120
MACHAA_NAVIGATION_TIMEOUT_MS=30000
MACHAA_HEADLESS=true

# Docker sets this to true because the browser runs as a non-root user
# with its capabilities dropped. Leave false when you run Python directly.
MACHAA_CHROMIUM_NO_SANDBOX=false

# Optional search APIs. Leave these empty. Day 1 works with no key:
# Google is opened first, and DuckDuckGo's public HTML results are used
# when Google shows a robot check or a consent page. Machaa does not solve
# those pages. A Brave Search API key (free tier, about 2,000 queries a
# month) or a Google Programmable Search key plus cx (free tier, about 100
# queries a day) is used only when the value below is filled in. Do not
# commit a real key.
MACHAA_BRAVE_SEARCH_API_KEY=
MACHAA_GOOGLE_SEARCH_API_KEY=
MACHAA_GOOGLE_SEARCH_CX=

# Optional. Leave this empty until you want a Word document.
# Get a free key at https://aistudio.google.com/apikey
# Put the real key only in .env on your computer, never in this example.
# On Windows: save .env beside start.bat, press Ctrl+C in the Machaa
# window, then double-click start.bat again.
GEMINI_API_KEY=
# Current free-tier model. If this name is rejected, Machaa tries other
# current Gemini models on its own. Change this line only if you want a
# specific model.
GEMINI_MODEL=gemini-3.5-flash-lite
